# Where each game is hosted. Optional: they default to the fewerlabs.dev subdomains
# (deepdive., ripple., skip.), and in `npm run dev` to the local game dev servers.
# VITE_GAME_DEEP_DIVE_URL=https://deepdive.fewerlabs.dev
# VITE_GAME_RIPPLE_URL=https://ripple.fewerlabs.dev
# VITE_GAME_SKIP_URL=https://skip.fewerlabs.dev
# Optional: Draw Am defaults to https://www.drawam.app and opens on its own site.
VITE_GAME_DRAW_AM_URL=https://www.drawam.app
