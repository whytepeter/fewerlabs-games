# Where each game is hosted. Set these in Vercel (Project → Settings → Environment Variables)
# once the games are deployed. In `npm run dev` they default to the local game dev servers.
VITE_GAME_DEEP_DIVE_URL=https://deep-dive.example.vercel.app
VITE_GAME_RIPPLE_URL=https://ripple.example.vercel.app
VITE_GAME_SKIP_URL=https://skip.example.vercel.app
# Optional: Draw Am defaults to https://www.drawam.app and opens on its own site.
VITE_GAME_DRAW_AM_URL=https://www.drawam.app
