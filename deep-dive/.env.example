# Firebase (optional). Leave these unset and the game runs fully offline from localStorage.
# Firebase console > Project settings > Your apps > Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local development against the emulators in ../firebase (no real project needed):
#   VITE_FIREBASE_PROJECT_ID=demo-fewerlabs
#   VITE_FIREBASE_API_KEY=demo
#   VITE_FIREBASE_EMULATORS=true

# Rewarded ads (Google H5 Games Ads, part of AdSense). Leave unset for no ads; the dev server then
# shows a stand-in "test ad". Set VITE_ADS_TEST=true to get Google's test ads while setting up.
VITE_ADSENSE_CLIENT=
VITE_ADS_TEST=
