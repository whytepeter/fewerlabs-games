rules_version = '2';

// Fewer Labs Games. Players sign in anonymously; see deep-dive/src/core/cloud.ts.
//   players/{uid}/saves/{game}         a player's cloud backup, private to them
//   leaderboards/{game}/scores/{uid}   one public row per player, best can only go up
//   leaderboards/{game}/days/{day}/scores/{uid}   the same, for one day's daily challenge
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function knownGame(game) {
      return game in ['deep-dive', 'ripple', 'skip'];
    }
    function validSave() {
      let d = request.resource.data;
      return d.keys().hasOnly(['data', 'updatedAt'])
        && d.data is map
        && d.updatedAt is number;
    }
    function validScore() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'best', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 16
        && d.best is int && d.best > 0 && d.best <= 100000
        && d.updatedAt == request.time;
    }

    match /players/{uid}/saves/{game} {
      allow read, delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && knownGame(game) && validSave();
    }

    // A daily challenge's board: one per UTC day, the same rules as the all-time board.
    match /leaderboards/{game}/days/{day}/scores/{uid} {
      allow read: if knownGame(game);
      allow create: if signedInAs(uid) && knownGame(game) && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && validScore();
      allow update: if signedInAs(uid) && knownGame(game) && validScore()
        && request.resource.data.best >= resource.data.best;
    }

    match /leaderboards/{game}/scores/{uid} {
      allow read: if knownGame(game);
      allow create: if signedInAs(uid) && knownGame(game) && validScore();
      allow update: if signedInAs(uid) && knownGame(game) && validScore()
        && request.resource.data.best >= resource.data.best;
    }
  }
}
